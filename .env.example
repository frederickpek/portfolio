# Server-side only (`npm run fetch-data` / GitHub Actions). Never used in the browser bundle.
# Read-only GitHub PAT: Settings → Developer settings → Personal access tokens.
GITHUB_TOKEN=

# LeetCode handle for prefetch script (optional; defaults to frederickpek)
# LEETCODE_USERNAME=frederickpek

# Hide LeetCode in the UI (browser bundle only)
# VITE_LEETCODE_USERNAME=

# GitHub Pages project site: set to /portfolio/
# VITE_BASE_PATH=/
